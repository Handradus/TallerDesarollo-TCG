# 🐳 Configuración para DOCKER (Producción)

# --- BACKEND ---
# Puerto interno del contenedor (No cambiar)
PORT=3000

# Base de Datos
# IMPORTANTE: En Docker, el "host" es el NOMBRE DEL SERVICIO en docker-compose.yml
# No uses 'localhost', usa 'db'
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=tu_password_segura
DB_NAME=tcg_pokemon

# APIs y Secretos
JWT_SECRET=secreto_produccion_muy_largo
POKEMONTCG_API_KEY=tu_api_key
GOOGLE_CLIENT_ID=tu_google_client_id

# --- FRONTEND ---
# URL Pública: Es la dirección que escribirá el usuario en su navegador.
# Si estás probando en local con Docker, es localhost (puerto 80).
# Si es un servidor real, sería: https://tudominio.com/api
VITE_API_BASE_URL=http://localhost/api

# Google Auth
VITE_GOOGLE_CLIENT_ID=tu_google_client_id
